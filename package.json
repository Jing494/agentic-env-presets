{
  "name": "@local/agentic-env-presets",
  "version": "1.0.0",
  "private": true,
  "description": "Standard and PTC agent presets whose system prompt describes a plain agentic coding environment instead of a branded harness.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "verify.mjs",
    "gen-presets.mjs",
    "presets-standard.patch.yml",
    "presets-ptc.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "移植说明.md",
    "PROMPT.md"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./presets-standard.patch.yml",
        "./presets-ptc.patch.yml"
      ]
    }
  }
}
