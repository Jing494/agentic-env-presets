{
  "name": "dsh-agentic-env-presets",
  "version": "1.1.1",
  "description": "Standard and PTC agent presets whose system prompt describes a plain agentic coding environment instead of a branded harness.",
  "license": "MIT",
  "author": "Jing494",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "dsh-bundle",
    "dsh-plugin",
    "agent-preset",
    "system-prompt",
    "deepseek-harness"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jing494/agentic-env-presets.git"
  },
  "bugs": {
    "url": "https://github.com/Jing494/agentic-env-presets/issues"
  },
  "homepage": "https://github.com/Jing494/agentic-env-presets#readme",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "verify.mjs",
    "gen-presets.mjs",
    "presets-standard.patch.yml",
    "presets-ptc.patch.yml",
    "locale/*.json",
    "docs/*.md",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./presets-standard.patch.yml",
        "./presets-ptc.patch.yml"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    }
  }
}
